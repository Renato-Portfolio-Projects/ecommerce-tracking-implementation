---
import StorePage from '../layouts/StorePage.astro';
import { WORDS } from '../store/words';
import { SITE_LINKS } from '../store/site';
---

<StorePage title={WORDS['about.title']} description={WORDS['about.description']}>
  <h1>{WORDS['about.heading']}</h1>
  <p>{WORDS['about.p1']}</p>
  <p>{WORDS['about.p2']}</p>
  <p>{WORDS['about.p3']}</p>
  <h2>{WORDS['about.readMore']}</h2>
  <ul>
    <li><a href={SITE_LINKS.project}>{WORDS['footer.github']}</a></li>
    <li><a href={SITE_LINKS.guide}>{WORDS['footer.guide']}</a></li>
  </ul>
</StorePage>
