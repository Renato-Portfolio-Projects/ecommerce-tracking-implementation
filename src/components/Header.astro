---
import { CURRENCIES } from '../store/currencies';
import { WORDS } from '../store/words';

const links = [
  { href: '/#tees', label: WORDS['nav.tees'] },
  { href: '/#pants', label: WORDS['nav.pants'] },
  { href: '/about', label: WORDS['nav.about'] },
];

// The cart link says "Cart" when the cart is empty and "Cart (3)" once it holds something. The cart's own
// script fills in the number, so the words for both are written into the page for it to use.
const cartWords = {
  empty: WORDS['header.cart'],
  count: WORDS['header.cartCount'],
  one: WORDS['header.cartLabelOne'],
  many: WORDS['header.cartLabelMany'],
};

// On the cart page the cart link points at the page the shopper is already on, so it is marked as the current
// page. That tells a screen reader where they are, and tells cart-ui.ts to leave a click on it alone, since
// following it would only reload the page.
const onCartPage = Astro.url.pathname.replace(/\/$/, '') === '/cart';
---

<header class="header">
  <a class="wordmark" href="/">{WORDS['site.name']}</a>
  <nav class="nav" aria-label={WORDS['nav.label']}>
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>
  <div class="tools">
    <label class="currency-picker">
      <span class="label">{WORDS['header.currency']}</span>
      <select id="currency-select">
        {CURRENCIES.map((currency) => <option value={currency.code}>{WORDS[`currency.${currency.code}`]}</option>)}
      </select>
    </label>
    <a class="cart-indicator" href="/cart" data-cart-link data-words={JSON.stringify(cartWords)} aria-current={onCartPage ? 'page' : undefined}>{WORDS['header.cart']}</a>
  </div>
</header>

<script>
  import { initCurrencySwitcher } from './currency-switcher';
  import { initListHandoffLinks } from './list-handoff-links';
  initCurrencySwitcher();
  initListHandoffLinks();
</script>
