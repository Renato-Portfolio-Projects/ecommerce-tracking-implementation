---
import type { GarmentKind, Print } from '../store/art';
import type { Colour } from '../store/products';
import { garmentSvg } from './garments';

interface Props {
  kind: GarmentKind;
  colour: Colour;
  print?: Print;
  /** The description of the drawing, for people who cannot see it. See garmentLabel. */
  label: string;
}

const { kind, colour, print = 'none', label } = Astro.props;
---

<Fragment set:html={garmentSvg(kind, colour, print, label)} />
