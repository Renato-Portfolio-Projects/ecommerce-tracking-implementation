---
import { fill } from '../engine/fill';
import { CART_LIFETIME_DAYS } from '../store/policy';
import { WORDS } from '../store/words';
import { welcomeOffer } from './welcome-offer';

interface Props {
  /** True on the one page where the popup opens by itself, which is the home page. Everywhere else it opens only when asked. */
  auto?: boolean;
}

const { auto = false } = Astro.props;
const percent = welcomeOffer().percentOff;

// The sentences the popup's script fills in later, written into the page so that it does not have to carry
// the words file. The code is deliberately not here: the script adds it only when the form is accepted, so
// it is not in the page's source, and it is in one place only.
const words = {
  demoAnnounce: WORDS['popup.demoAnnounce'],
  success: WORDS['popup.success'],
  loadFailed: WORDS['popup.loadFailed'],
  percent: String(percent),
};
---

{/* The lead popup: a native dialog like the cart drawer, so the browser gives it focus trapping, Escape and the
     return of focus. It is on every store page, closed, because the footer link and the corner tab open it from
     anywhere. It opens by itself only where `auto` is set. The form is checked by script, so the browser's own
     checks are off (`novalidate`), and it posts, never gets, so nothing a visitor types can ever end up in an
     address. Nothing here can be seen or used until the script that opens it is loaded. */}
<dialog class="lead-popup" data-lead-popup data-lead-auto={auto ? '' : undefined} aria-labelledby="lead-popup-title" data-words={JSON.stringify(words)}>
  <div class="lead-head">
    <h2 class="lead-title" id="lead-popup-title">{fill(WORDS['popup.title'], { percent })}</h2>
    <button type="button" class="lead-close" data-lead-close="close-button" aria-label={WORDS['popup.close']}>
      <span aria-hidden="true">&times;</span>
    </button>
  </div>

  <div data-lead-ask>
    <p class="lead-body">{WORDS['popup.body']}</p>

    <form class="lead-form" method="post" novalidate data-lead-form>
      <div class="lead-field">
        <label for="lead-first-name">{WORDS['popup.firstName']}</label>
        <input id="lead-first-name" name="firstName" type="text" autocomplete="given-name" required autofocus />
        <p class="lead-error" id="lead-first-name-error" data-lead-error="firstName" hidden></p>
      </div>

      <div class="lead-field">
        <label for="lead-email">{WORDS['popup.email']}</label>
        <input id="lead-email" name="email" type="email" inputmode="email" autocomplete="email" autocapitalize="none" spellcheck="false" required />
        <p class="lead-error" id="lead-email-error" data-lead-error="email" hidden></p>
      </div>

      {/* Never ticked for the visitor, and no demo button ticks it: agreeing to marketing is always deliberate. */}
      <label class="lead-check">
        <input type="checkbox" name="marketing" />
        <span>{WORDS['popup.marketing']}</span>
      </label>

      <button type="submit" class="btn lead-submit" data-lead-submit>{WORDS['popup.submit']}</button>
      {/* Shown by the script only if the form's code cannot be loaded, which is rare. The browser does not try a failed load again by itself, so the visitor is asked to reload the page. */}
      <p class="lead-error" role="alert" data-lead-load-error hidden></p>

      <div class="lead-demo">
        <button type="button" class="link-button" data-lead-demo data-cta="Demo Data - Lead popup">{WORDS['popup.demoButton']}</button>
        {/* Shown by the script once a person has been filled in. It carries no tracking label: it is a
             convenience, not something the business wants to count. */}
        <button type="button" class="link-button" data-lead-new-person hidden>{WORDS['popup.newPerson']}</button>
      </div>
      <p class="lead-note">{fill(WORDS['popup.demoNote'], { days: CART_LIFETIME_DAYS })}</p>
      <p class="visually-hidden" role="status" data-lead-announce></p>
    </form>

    <button type="button" class="link-button lead-decline" data-lead-close="no-thanks">{WORDS['popup.noThanks']}</button>
  </div>

  {/* What the visitor sees once the form is accepted. The script writes the sentence, with the code, into it. */}
  <div class="lead-success" data-lead-success hidden tabindex="-1" role="status">
    <p data-lead-success-text></p>
  </div>
</dialog>

{/* The small tab in the corner. It stays hidden until the script decides a reminder belongs on the page (the
     popup was shown and the code was not taken), and it shows the offer, never the code. */}
<button type="button" class="lead-tab" data-lead-open="tab" data-cta="Lead Popup - Corner tab" aria-haspopup="dialog" hidden>
  {fill(WORDS['popup.reopen'], { percent })}
</button>
