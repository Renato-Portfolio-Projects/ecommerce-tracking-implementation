---
import { fill } from '../engine/fill';
import { WORDS } from '../store/words';
import { SITE_LINKS } from '../store/site';
import { welcomeOffer } from './welcome-offer';

interface Props {
  /** False on checkout and thank-you, where the popup itself does not appear either, so this button would open nothing. */
  leadPopup?: boolean;
}

const { leadPopup = true } = Astro.props;
---

<footer class="footer">
  <div class="footer-inner">
    <div>
      <p class="wordmark plain">{WORDS['site.name']}</p>
      <p>{WORDS['site.tagline']}</p>
      {/* Opens the lead popup by hand, from any page that has one. It is a button, not a link, because it does
           something on the page instead of going somewhere. It shows the offer, never the code. */}
      {leadPopup && (
        <button type="button" class="link-button" data-lead-open="footer" data-cta="Lead Popup - Footer link" aria-haspopup="dialog">
          {fill(WORDS['popup.reopen'], { percent: welcomeOffer().percentOff })}
        </button>
      )}
    </div>
    <div>
      <p class="label">{WORDS['footer.demoHeading']}</p>
      <ul>
        <li><a href={SITE_LINKS.project} data-cta="Footer - GitHub">{WORDS['footer.github']}</a></li>
        <li><a href={SITE_LINKS.guide} data-cta="Footer - Production guide">{WORDS['footer.guide']}</a></li>
      </ul>
    </div>
    <div>
      <p class="label">{WORDS['footer.helpHeading']}</p>
      <ul>
        <li><a href="/policies/shipping" data-cta="Footer - Shipping">{WORDS['footer.shipping']}</a></li>
        <li><a href="/policies/returns" data-cta="Footer - Returns">{WORDS['footer.returns']}</a></li>
        <li><a href="/policies/terms" data-cta="Footer - Terms">{WORDS['footer.terms']}</a></li>
        <li><a href="/contact" data-cta="Footer - Contact">{WORDS['footer.contact']}</a></li>
      </ul>
    </div>
  </div>
  <p class="footer-small">{WORDS['footer.small']}</p>
</footer>
